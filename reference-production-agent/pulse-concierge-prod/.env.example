# Pulse Concierge Production Reference Agent (.env.example)
# Terraform (scripts/deploy_and_verify.py) writes the real .env; values below are placeholders.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
PROJECT_NUMBER=your-project-number
GOOGLE_CLOUD_LOCATION=eu
PULSE_LIVE_MODEL=gemini-3.8-live
PULSE_LIVE_LOCATION=eu
MODEL=gemini-3.8-flash
BQ_LOCATION=EU
BQ_DATASET_CRM=telco_crm
BQ_DATASET_BILLING=telco_billing
BQ_DATASET_NETWORK=telco_network
PERSONA_ADMIN_SA=persona-alex-exec@your-project-id.iam.gserviceaccount.com
PERSONA_SPECIALIST_SA=persona-elena-care@your-project-id.iam.gserviceaccount.com
PULSE_REGISTRY_LOCATION=europe-west4
PULSE_SKILLS_LOCATION=eu
PULSE_IAM_MCP_URL=https://pulse-iam-context-mcp-your-project-number.europe-west4.run.app/mcp
PULSE_NETWORK_OPS_AGENT_CARD=https://pulse-network-ops-agent-your-project-number.europe-west4.run.app/.well-known/agent-card.json
PULSE_MODEL_ARMOR_INPUT_TEMPLATE=projects/your-project-id/locations/europe-west4/templates/pulse-prod-guard-input
PULSE_MODEL_ARMOR_OUTPUT_TEMPLATE=projects/your-project-id/locations/europe-west4/templates/pulse-prod-guard-output
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_API_PREVENT_AGENT_TOKEN_SHARING_FOR_GCP_SERVICES=false
UV_NO_SYNC=1
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
